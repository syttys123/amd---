<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AmdMobilePower.Core\AmdMobilePower.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>AMD Mobile Power Worker</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <RyzenAdjRuntimeDirectory>$(MSBuildProjectDirectory)\..\..\artifacts\ryzenadj-runtime</RyzenAdjRuntimeDirectory>
    <RepositoryProfilesDirectory>$(MSBuildProjectDirectory)\..\..\profiles</RepositoryProfilesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <RyzenAdjRuntimeFiles Include="$(RyzenAdjRuntimeDirectory)\*" Condition="Exists('$(RyzenAdjRuntimeDirectory)')" />
    <ProfileFiles Include="$(RepositoryProfilesDirectory)\*.json" Condition="Exists('$(RepositoryProfilesDirectory)')" />
  </ItemGroup>

  <Target Name="StageNativeRuntime" AfterTargets="Build">
    <Copy SourceFiles="@(RyzenAdjRuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProfileFiles)" DestinationFolder="$(OutDir)profiles" SkipUnchangedFiles="true" />
  </Target>

</Project>
