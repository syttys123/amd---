<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AmdMobilePower.Core\AmdMobilePower.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AmdMobilePower</AssemblyName>
    <AssemblyTitle>AMD Mobile Power</AssemblyTitle>
    <Description>Capability-aware AMD laptop power manager</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\amd-mobile-power.ico"
          Link="assets\amd-mobile-power.ico"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\amd-mobile-power-256.png"
          Link="assets\amd-mobile-power-256.png"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
